# =============================================================================
# STOKER BACKEND — VARIÁVEIS DE AMBIENTE
# =============================================================================

# BANCO DE DADOS POSTGRESQL (Supabase / Neon / Render / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stoker?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/stoker?schema=public"

# AUTENTICAÇÃO JWT
JWT_SECRET="stoker-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="stoker-super-secret-refresh-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SERVIDOR
PORT=4000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

